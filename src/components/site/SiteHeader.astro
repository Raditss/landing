---
import mark from "../../assets/mark.svg";
import { nav } from "../../data/site";
import { url, repoUrl } from "../../lib/site";
import Wordmark from "./Wordmark.astro";

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = pathname.slice(base.length) || "/";

function isCurrent(href: string) {
  if (href === "/") return here === "/";
  return here.startsWith(href);
}
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={url("/")} aria-label="Vizier home">
      <img src={mark.src} alt="" width="30" height="30" />
      <Wordmark size={20} state="live" />
    </a>

    <nav class="site-nav" aria-label="Main">
      {nav.map((item) =>
        item.external ? (
          <a class="site-nav__link" href={item.href} target="_blank" rel="noopener noreferrer">
            {item.label}
          </a>
        ) : (
          <a
            class="site-nav__link"
            href={url(item.href)}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="site-header__actions">
      <a
        class="site-header__icon"
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Vizier on GitHub"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <details class="mobile-nav">
        <summary aria-label="Open menu">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="mobile-nav__panel">
          {nav.map((item) => (
            <a
              href={item.external ? item.href : url(item.href)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>
