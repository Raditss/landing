---
import { Image } from "astro:assets";
import memory from "../../assets/shots/memory.png";
import tasks from "../../assets/shots/tasks.png";
import workspace from "../../assets/shots/workspace.png";
import { url } from "../../lib/site";

const sections = [
  {
    id: "workspace",
    label: "Workspace",
    title: "Bring every agent into the room.",
    body: "A Workspace is a shared space for your people and your agents, with topics. Agents read along without spending a token, and answer only when someone mentions them. Each brings its own memory and tools, so one can find the place and another can check it against the budget, in the same thread.",
    // The released docs do not have this page yet: back to /docs/configuration/workspaces/ once they do.
    link: { label: "About Workspaces", href: "https://github.com/vizier-lab/vizier/blob/develop/docs/src/configuration/workspaces.md" },
    image: workspace,
    alt: "A Workspace topic called road-trip. Dorothy asks where to stop for lunch. Oz mentions @toto, who recommends a place, then mentions @tin, who checks the cost against the money set aside for the drive.",
  },
  {
    id: "memory",
    label: "Memory",
    title: "See how the reasoning connects.",
    body: "Memory is a graph of what the agent actually wrote: each document a node, each link between two thoughts an edge, the largest nodes the ones it returns to. Open any node and you get the passage itself — which lines, and whether a person, a conversation or the nightly reflection wrote it. If it is wrong, fix the source and the next answer uses the fix.",
    link: { label: "How memory works", href: url("/docs/configuration/memory/") },
    image: memory,
    alt: "The Memory page for an agent called Tin: its summer-trip bundle drawn as a link graph of its documents, such as Who Paid What and The Cabin, beside the document tree.",
  },
  {
    id: "work",
    label: "Scheduled work",
    title: "See what it did without you.",
    body: "Ask once and the agent schedules the follow-ups itself: a Sunday summary, a nudge about a balance, a budget check the day before you leave. Each task records who asked, when it next runs and whether the last run answered; the answer itself is kept with the run, so unattended work never disappears into a log.",
    link: { label: "Scheduled tasks", href: url("/docs/configuration/agents/#tasks") },
    image: tasks,
    alt: "The Schedule page for an agent called Tin, as a table of four tasks it set up when Oz asked, each with its schedule, requester and latest run.",
  },
];
---

{sections.map((section) => (
  <section class="section evidence" id={section.id}>
    <div class="shell">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="mono evidence__label">{section.label}</p>
          <h2 class="display-lg">{section.title}</h2>
        </div>
        <div class="section-head__aside">
          <p class="body-copy">{section.body}</p>
          <a class="mono section-head__link" href={section.link.href}>{section.link.label} →</a>
        </div>
      </div>
      <div class="shot__frame">
        <Image
          class="shot__img"
          src={section.image}
          alt={section.alt}
          widths={[720, 1080, 1440, 2160]}
          sizes="(max-width: 860px) 100vw, 1240px"
          loading="lazy"
        />
      </div>
    </div>
  </section>
))}
