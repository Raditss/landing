---
import { appDownloads, latestAppVersion } from "../../lib/release";
import { installCommand, repoUrl, url } from "../../lib/site";

const downloads = appDownloads(await latestAppVersion());
---

<section class="hero">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <h1 class="display-xl hero__title reveal">
        A digital steward<br />
        for <em>Your Majesty.</em>
      </h1>

      <p class="lede reveal reveal-2">
        AI agents that remember who they are, and who you are. Hosted by you.
        Each agent keeps a written identity and a memory you can open, so a
        decision made three weeks ago is still there on Monday — with the reason
        and the receipt.
      </p>

      <div class="hero__actions reveal reveal-3">
        <a
          class="btn btn-primary"
          id="hero-download"
          href="#install"
          data-windows={downloads.windows}
          data-macos={downloads.macos}
          data-linux-x64={downloads.linuxX64}
          data-linux-arm64={downloads.linuxArm64}
        >
          Install Vizier
        </a>
        <a class="btn btn-secondary" href="#why">See how it works</a>
        <a class="hero__gh-link mono" href={repoUrl} target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>

      <p class="hero__download-note mono" id="hero-download-note" hidden>
        <span id="hero-download-platform"></span> · Not code-signed yet ·{" "}
        <a href={url("/docs/getting-started/desktop-app/")}>Other platforms and setup →</a>
      </p>

      <div class="install-line reveal reveal-4">
        <code id="install-command">{installCommand}</code>
        <button class="copy-button" type="button" data-copy-target="install-command">Copy</button>
      </div>
    </div>

    <div class="hero__shot reveal reveal-3">
      <figure class="shot">
        <div class="shot__frame">
          <video
            id="hero-video"
            class="shot__video"
            src={url("/media/vizier-launch.mp4")}
            poster={url("/media/vizier-launch.jpg")}
            width="1920"
            height="1080"
            playsinline
            controls
            preload="none"
            aria-label="Vizier's launch video. Own your intelligence: memory as plain markdown on your disk, a Workspace where people and agents share one room, and a desktop app or a server, your call."
          >
            <a href={url("/media/vizier-launch.mp4")}>Watch the Vizier launch video</a>
          </video>
        </div>
        <figcaption class="shot__caption">
          <span>Real screens from a demo instance.</span>
          <span class="mono">Vizier · 20s</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  // Offers the installer for the visitor's OS. Phones, tablets and anything
  // unrecognised keep "Install Vizier": the desktop app does not run there.
  (() => {
    const button = document.getElementById("hero-download");
    const note = document.getElementById("hero-download-note");
    const platformLabel = document.getElementById("hero-download-platform");
    if (!button || !note || !platformLabel) return;

    const nav = navigator;
    const ua = nav.userAgent;
    const hint = nav.userAgentData;
    const platform = (hint && hint.platform) || nav.platform || "";
    const os = platform + " " + ua;
    if (
      (hint && hint.mobile) ||
      /Android|iPhone|iPad|iPod|CrOS/i.test(ua) ||
      (/Mac/i.test(os) && nav.maxTouchPoints > 1)
    ) {
      return;
    }

    const offer = (name, href, label) => {
      button.textContent = "Download for " + name;
      button.href = href;
      platformLabel.textContent = label;
      note.hidden = false;
    };
    const links = button.dataset;

    if (/Win/i.test(os)) {
      offer("Windows", links.windows, "Windows 10/11, x64");
    } else if (/Mac/i.test(os)) {
      offer("macOS", links.macos, "macOS 11+, Apple Silicon and Intel");
    } else if (/Linux|X11/i.test(os)) {
      const arm = () => offer("Linux", links.linuxArm64, "Linux arm64 AppImage");
      offer("Linux", links.linuxX64, "Linux x86_64 AppImage");
      if (/aarch64|arm64/i.test(os)) arm();
      else if (hint && hint.getHighEntropyValues) {
        hint
          .getHighEntropyValues(["architecture"])
          .then((values) => {
            if (values.architecture === "arm") arm();
          })
          .catch(() => {});
      }
    }
  })();
</script>
